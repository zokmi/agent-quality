{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [{
          "type": "command",
          "command": "node \"$PLUGIN_ROOT/bin/quality.mjs\" hook",
          "command_windows": "node \"$env:PLUGIN_ROOT/bin/quality.mjs\" hook",
          "timeout": 35
        }]
      }
    ],
    "Stop": [
      {
        "hooks": [{
          "type": "command",
          "command": "node \"$PLUGIN_ROOT/bin/quality.mjs\" hook",
          "command_windows": "node \"$env:PLUGIN_ROOT/bin/quality.mjs\" hook",
          "timeout": 35
        }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{
          "type": "command",
          "command": "node \"$PLUGIN_ROOT/bin/quality.mjs\" hook",
          "command_windows": "node \"$env:PLUGIN_ROOT/bin/quality.mjs\" hook",
          "timeout": 10
        }]
      }
    ]
  }
}
